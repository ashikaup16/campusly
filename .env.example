SECRET_KEY=replace-this-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DB_ENGINE unset to use SQLite for local development.
# Set DB_ENGINE=mysql and provide the values below to use MySQL.
DB_ENGINE=
DB_NAME=campus_events
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Configure SMTP to deliver real event / application emails.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Campus Portal <no-reply@example.com>
SITE_BASE_URL=http://127.0.0.1:8765
